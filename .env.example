# Integração Asaas
ASAAS_API_KEY='$aact_prod_000MzkwODA2MWY2OGM3MWRlMDU2NWM3MzJlNzZmNGZhZGY6OjVlNmQ0MzBjLTFlNjQtNDE2ZC05ZDA0LTYwNmVkOWZiNWNiMDo6JGFhY2hfOTY0ZmQ3MzQtZjQyZi00MDk2LWI3ZDEtM2Q1ZjE2NTRkY2Zi'  # Substitua pela sua chave de API
ASAAS_API_URL='https://api.asaas.com/v3'
# Configurações do Servidor
PORT=5000
NODE_ENV=development

# Configurações do Banco de Dados PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gerencie_db
DB_USER=vision_user
DB_PASSWORD=123456

# Configurações de Autenticação
JWT_SECRET=sua_chave_secreta_aqui
JWT_EXPIRE=7d

# Configurações da OpenAI
OPENAI_API_KEY=sua_chave_openai_aqui
OPENAI_MODEL=gpt-4

# CORS
CORS_ORIGIN=http://localhost:3000

# Integração Google Calendar (console.cloud.google.com)
GOOGLE_CLIENT_ID=seu_client_id_aqui
GOOGLE_CLIENT_SECRET=seu_client_secret_aqui
GOOGLE_REDIRECT_URI=http://localhost:5000/api/google/callback

# Segurança (veja SEGURANCA_E_RECUPERACAO.md)
# Token que o Asaas envia no header "asaas-access-token" do webhook (defina o mesmo valor no painel do Asaas)
ASAAS_WEBHOOK_TOKEN=
# Chave pra criptografar a senha do eCAC no banco (texto longo e aleatório, mínimo 16 caracteres; guarde em local seguro!)
ECAC_ENCRYPTION_KEY=

# Modelo da Aline (assistente que ensina a usar o sistema). Padrão: gpt-4o-mini. Modelos muito fracos inventam botões que não existem.
OPENAI_MODEL_AJUDA=
